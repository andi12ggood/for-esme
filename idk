
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Esme ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');

:root {
 --pink:#ff91b5;
 --rose:#d96691;
 --dark:#81415d;
 --soft:#fff1f6;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}

body{
 background:#fff4f8;
 color:var(--dark);
 font-family:'DM Sans',sans-serif;
 overflow-x:hidden;
}

button{font-family:inherit;cursor:pointer}

#particles{
 position:fixed;
 inset:0;
 overflow:hidden;
 pointer-events:none;
 z-index:0;
}

.particle{
 position:absolute;
 bottom:-40px;
 color:#e98eae;
 animation:floatUp linear forwards;
 opacity:0;
}

@keyframes floatUp{
 10%{opacity:.6}
 100%{transform:translateY(-115vh) rotate(360deg);opacity:0}
}

.glow{
 position:fixed;
 width:350px;
 height:350px;
 background:#ffb9d1;
 filter:blur(120px);
 opacity:.25;
 border-radius:50%;
 pointer-events:none;
}

.glow.one{top:-150px;left:-130px}
.glow.two{bottom:-150px;right:-130px}

.wrapper{
 position:relative;
 z-index:1;
 width:min(850px,91%);
 margin:auto;
}

header{
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:25px 0;
}

.brand{
 font-family:'Great Vibes',cursive;
 font-size:32px;
 color:#d66c92;
}

.header-label{
 font-size:10px;
 letter-spacing:3px;
 color:#bd8398;
}

.hero{
 min-height:82vh;
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 text-align:center;
 padding:35px 10px;
}

.eyebrow{
 letter-spacing:4px;
 font-size:10px;
 color:#bd8098;
 margin-bottom:25px;
}

.hero-heart{
 font-size:48px;
 animation:beat 2s infinite;
}

@keyframes beat{
 0%,100%{transform:scale(1)}
 15%{transform:scale(1.17)}
 30%{transform:scale(1)}
 45%{transform:scale(1.1)}
}

.hero h1{
 font-family:'Great Vibes',cursive;
 font-size:clamp(75px,15vw,130px);
 font-weight:400;
 color:#cb6289;
 line-height:1.2;
}

.hero h2{
 font-family:'Playfair Display',serif;
 font-weight:500;
 font-size:22px;
 color:#9c5976;
 margin-top:8px;
}

.hero p{
 max-width:420px;
 color:#a77a8d;
 font-size:14px;
 line-height:2;
 margin:23px auto 30px;
}

.btn{
 border:none;
 border-radius:50px;
 background:linear-gradient(135deg,#f5a1bc,#d85f8a);
 color:white;
 padding:15px 28px;
 font-size:13px;
 font-weight:700;
 box-shadow:0 9px 28px #d85f8a40;
 transition:.3s;
}

.btn:hover{transform:translateY(-4px);box-shadow:0 14px 30px #d85f8a55}
.btn:active{transform:scale(.96)}

.scroll-hint{
 margin-top:45px;
 font-size:10px;
 letter-spacing:3px;
 color:#c28ca1;
}

main{padding-bottom:65px}

.section{
 margin:35px 0;
 padding:36px;
 background:#ffffffc9;
 border:1px solid white;
 border-radius:27px;
 box-shadow:0 15px 55px #ce789622;
 backdrop-filter:blur(15px);
}

.heading{
 font-family:'Playfair Display',serif;
 text-align:center;
 font-size:31px;
 font-weight:500;
 color:#bd5e83;
}

.desc{
 text-align:center;
 color:#a77c8e;
 font-size:13px;
 line-height:1.8;
 margin:12px auto 25px;
}

.ornament{
 text-align:center;
 color:#e99bb7;
 letter-spacing:8px;
 margin:15px 0;
}

/* ENVELOPE */

.envelope-area{
 display:flex;
 justify-content:center;
 padding:35px 0 10px;
}

.envelope{
 position:relative;
 width:220px;
 height:145px;
 background:#e991ae;
 border-radius:5px;
 cursor:pointer;
 box-shadow:0 12px 30px #d77c9c55;
 transition:transform .3s;
}

.envelope:hover{transform:translateY(-5px)}

.envelope-back{
 position:absolute;
 inset:0;
 background:#f2b2c7;
 border-radius:5px;
}

.envelope-flap{
 position:absolute;
 inset:0;
 background:#f8c9d8;
 clip-path:polygon(0 0,100% 0,50% 60%);
 transform-origin:top;
 transition:transform .7s ease;
 z-index:3;
}

.envelope.open .envelope-flap{
 transform:rotateX(180deg);
}

.envelope-front{
 position:absolute;
 inset:0;
 background:#e78ba9;
 clip-path:polygon(0 100%,50% 44%,100% 100%);
 z-index:4;
}

.envelope-seal{
 position:absolute;
 left:50%;
 top:56%;
 transform:translate(-50%,-50%);
 width:38px;
 height:38px;
 background:#c75b82;
 color:white;
 border-radius:50%;
 display:grid;
 place-items:center;
 z-index:5;
 transition:.3s;
}

.envelope.open .envelope-seal{
 opacity:0;
}

.envelope.open{
 pointer-events:none;
}

.open-hint{
 text-align:center;
 font-size:11px;
 color:#bc8298;
 margin-top:18px;
}

/* LETTER - SEPARATE FROM ENVELOPE */

.letter{
 display:none;
 margin-top:35px;
 padding:30px;
 border:1px solid #f5d6e2;
 border-radius:20px;
 background:linear-gradient(145deg,#fff3f7,#fffafd);
 box-shadow:0 12px 35px #d98aa622;
}

.letter.show{
 display:block;
 animation:letterAppear .9s ease both;
}

@keyframes letterAppear{
 from{opacity:0;transform:translateY(25px) scale(.97)}
 to{opacity:1;transform:translateY(0) scale(1)}
}

.letter p{
 font-family:'Playfair Display',serif;
 font-size:15px;
 line-height:2.1;
 color:#916177;
}

.signature{
 font-family:'Great Vibes',cursive;
 font-size:37px;
 color:#d56d94;
 text-align:right;
 margin-top:25px;
}

/* REASONS */

.reasons{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:14px;
}

.reason{
 padding:22px 18px;
 background:#fff3f7;
 border:1px solid #fce1ea;
 border-radius:19px;
 transition:.3s;
}

.reason:hover{
 transform:translateY(-5px);
 box-shadow:0 9px 20px #d98aa622;
}

.reason .icon{font-size:26px;margin-bottom:12px}
.reason h3{
 font-family:'Playfair Display',serif;
 font-size:19px;
 color:#bd6385;
 margin-bottom:9px;
}

.reason p{
 font-size:12px;
 color:#a57a8c;
 line-height:1.8;
}

/* GAME */

.game{
 background:linear-gradient(145deg,#fff0f6,#fff9fb);
 border:1px solid #f6d8e4;
 border-radius:22px;
 padding:20px;
}

.game-top{
 display:flex;
 justify-content:space-between;
 font-size:12px;
 font-weight:700;
 color:#b35f80;
 margin-bottom:15px;
}

.progress{
 height:7px;
 background:#f4d6e2;
 border-radius:20px;
 margin-bottom:17px;
 overflow:hidden;
}

.progress-inner{
 width:0%;
 height:100%;
 background:linear-gradient(90deg,#ffa8c5,#d75e89);
 transition:.3s;
}

.play-area{
 height:290px;
 position:relative;
 overflow:hidden;
 border-radius:17px;
 background:radial-gradient(circle,#fff0f6,#fffafd);
 border:1px dashed #edb0c6;
}

.start-screen,.finish-screen{
 position:absolute;
 inset:0;
 display:flex;
 flex-direction:column;
 justify-content:center;
 align-items:center;
 text-align:center;
 padding:20px;
}

.start-screen .big,.finish-screen .big{font-size:48px}

.start-screen p,.finish-screen p{
 font-size:12px;
 color:#a47b8c;
 line-height:1.8;
 margin:13px 0 20px;
}

.game-heart{
 position:absolute;
 border:none;
 background:transparent;
 font-size:36px;
 animation:pop .25s ease;
 filter:drop-shadow(0 4px 5px #db7c9a55);
}

@keyframes pop{
 from{transform:scale(0)}
 to{transform:scale(1)}
}

.toast{
 display:none;
 text-align:center;
 font-family:'Playfair Display',serif;
 font-style:italic;
 color:#c15e84;
 font-size:14px;
 margin-top:17px;
}

/* FINAL */

.final-box{
 background:linear-gradient(140deg,#fff0f6,#fffafd);
 border-radius:22px;
 padding:35px 25px;
 text-align:center;
 border:1px solid #f9dbe6;
}

.final-box .big-heart{font-size:55px;animation:beat 2s infinite}

.final-box h3{
 font-family:'Great Vibes',cursive;
 color:#cf648c;
 font-size:48px;
 font-weight:400;
 margin:14px 0;
}

.final-box p{
 font-family:'Playfair Display',serif;
 font-size:15px;
 line-height:2.1;
 color:#96667c;
 max-width:500px;
 margin:auto;
}

.final-signature{
 font-family:'Great Vibes',cursive;
 font-size:38px;
 color:#d16c94;
 margin-top:22px;
}

/* SECRET HEART */

.secret-heart{
 position:fixed;
 right:20px;
 bottom:20px;
 width:53px;
 height:53px;
 border:none;
 border-radius:50%;
 background:linear-gradient(135deg,#ffbad1,#e86d9b);
 color:white;
 font-size:25px;
 z-index:50;
 box-shadow:0 6px 25px #d75e8970;
 animation:secretBeat 2.5s infinite;
}

@keyframes secretBeat{
 0%,100%{transform:scale(1)}
 50%{transform:scale(1.1)}
}

.secret-heart:hover{transform:scale(1.15)}

.secret-modal{
 position:fixed;
 inset:0;
 background:#71384e88;
 backdrop-filter:blur(8px);
 z-index:100;
 display:none;
 justify-content:center;
 align-items:center;
 padding:20px;
}

.secret-modal.open{display:flex;animation:appear .4s ease}

.secret-card{
 position:relative;
 width:min(420px,100%);
 padding:40px 28px;
 background:linear-gradient(145deg,#fff2f7,#fffafd);
 border:1px solid white;
 border-radius:27px;
 text-align:center;
 box-shadow:0 20px 70px #66304755;
 animation:letterAppear .6s ease;
}

.secret-card .secret-icon{
 font-size:45px;
 margin-bottom:15px;
}

.secret-card h2{
 font-family:'Great Vibes',cursive;
 color:#d0648d;
 font-size:43px;
 font-weight:400;
 margin-bottom:15px;
}

.secret-card p{
 font-family:'Playfair Display',serif;
 color:#95677c;
 line-height:2;
 font-size:15px;
}

.close-secret{
 position:absolute;
 right:17px;
 top:15px;
 border:none;
 background:#ffe5ef;
 color:#c36187;
 width:32px;
 height:32px;
 border-radius:50%;
 font-size:18px;
}

footer{
 text-align:center;
 padding:25px 0 45px;
 color:#c28da2;
 font-size:11px;
 letter-spacing:1px;
 line-height:2;
}

.hidden{display:none!important}

@keyframes appear{
 from{opacity:0;transform:translateY(15px)}
 to{opacity:1;transform:translateY(0)}
}

@media(max-width:600px){
 .section{padding:24px 16px}
 .reasons{grid-template-columns:1fr}
 .hero{min-height:78vh}
 .letter{padding:21px}
 .letter p{font-size:14px}
 .play-area{height:270px}
 .secret-heart{right:14px;bottom:14px}
}
</style>
</head>

<body>

<div id="particles"></div>
<div class="glow one"></div>
<div class="glow two"></div>

<div class="wrapper">

<header>
 <div class="brand">for Esme ♡</div>
 <div class="header-label">MADE JUST FOR YOU</div>
</header>

<section class="hero">
 <div class="eyebrow">✧ A LITTLE PLACE IN THIS WORLD ✧</div>
 <div class="hero-heart">💗</div>
 <h1>Dear Esme</h1>
 <h2>You make my world a little sweeter.</h2>

 <p>
 If I could give you one thing, it would be the chance
 to see yourself through my eyes, even just for a moment.
 Maybe then you'd understand how special you are to me.
 </p>

 <button class="btn" onclick="openPage()">
 Come inside, my love ♡
 </button>

 <div class="scroll-hint">MADE WITH ALL MY HEART ↓</div>
</section>

<main id="content" class="hidden">

<!-- LETTER -->

<section class="section">
 <h2 class="heading">A letter for you</h2>
 <div class="ornament">♡ ─── ♡</div>
 <p class="desc">
 I have something I want you to read.
 Tap the little envelope to open it.
 </p>

 <div class="envelope-area">
  <div class="envelope" id="envelope" onclick="openLetter()">
   <div class="envelope-back"></div>
   <div class="envelope-flap"></div>
   <div class="envelope-front"></div>
   <div class="envelope-seal">♥</div>
  </div>
 </div>

 <div class="open-hint" id="openHint">♡ TAP THE ENVELOPE ♡</div>

 <!-- This letter is outside the envelope now -->
 <div class="letter" id="letter">
  <p>
   Hey Esme,

   <br><br>

   I honestly wish I could show you just how much you mean
   to me instead of trying to explain it with words.
   You have no idea how happy I am that I got to meet you.
   Even the smallest things about you make me smile.

   <br><br>

   I love our conversations, the random things we talk
   about and all those little moments that might seem
   normal to you but mean so much to me.

   <br><br>

   I know I can mess up sometimes. I don't want you to
   think that means I care any less. I want to keep
   learning how to understand you better and how to
   make you feel loved, not just tell you that I do.

   <br><br>

   I hope we get to make so many more memories together.
   I want to hear about your good days, your bad days,
   your random thoughts and everything in between.

   <br><br>

   You don't have to be perfect. You don't have to
   pretend to be happy all the time. I like you for you,
   and that's what makes you so special to me.

   <br><br>

   Thank you for being in my life, Esme.
   I'm really glad it's you.
  </p>

  <div class="signature">With all my love, ♡</div>
 </div>
</section>

<!-- REASONS -->

<section class="section">
 <h2 class="heading">Little things I love</h2>
 <div class="ornament">✧ ♡ ✧</div>
 <p class="desc">Some things that make you my favourite person.</p>

 <div class="reasons">
  <div class="reason">
   <div class="icon">🌸</div>
   <h3>Your smile</h3>
   <p>I hope I get to be one of the reasons behind it.</p>
  </div>

  <div class="reason">
   <div class="icon">💌</div>
   <h3>Your messages</h3>
   <p>Even a simple hello from you can make my day.</p>
  </div>

  <div class="reason">
   <div class="icon">🦋</div>
   <h3>Your personality</h3>
   <p>There is something about you that makes you different from everyone else.</p>
  </div>

  <div class="reason">
   <div class="icon">🌙</div>
   <h3>Our late nights</h3>
   <p>Those random conversations I never want to end.</p>
  </div>

  <div class="reason">
   <div class="icon">🎀</div>
   <h3>The little things</h3>
   <p>All the tiny details about you that make me smile.</p>
  </div>

  <div class="reason">
   <div class="icon">💗</div>
   <h3>Just being you</h3>
   <p>You don't need to change anything to be special to me.</p>
  </div>
 </div>
</section>

<!-- GAME -->

<section class="section">
 <h2 class="heading">A little game for you</h2>
 <div class="ornament">♡ ─── ♡</div>
 <p class="desc">
  I have 7 hearts hidden for you.
  Catch them all to unlock something special.
 </p>

 <div class="game">
  <div class="game-top">
   <span>♡ Your hearts</span>
   <span id="counter">0 / 7</span>
  </div>

  <div class="progress">
   <div class="progress-inner" id="progress"></div>
  </div>

  <div class="play-area" id="playArea">
   <div class="start-screen" id="startScreen">
    <div class="big">💝</div>
    <h3 style="font-family:'Playfair Display';color:#bd6285">
     Catch my hearts
    </h3>
    <p>Tap the hearts as they appear. Each one has a little message for you.</p>
    <button class="btn" onclick="startGame()">Let's play ♡</button>
   </div>

   <div class="finish-screen hidden" id="finishScreen">
    <div class="big">💗</div>
    <h3 style="font-family:'Playfair Display';color:#bd6285">
     You found them all!
    </h3>
    <p>But there is one heart I didn't hide...</p>
    <button class="btn" onclick="showFinal()">Find out what it is ♡</button>
   </div>
  </div>

  <div class="toast" id="toast"></div>
 </div>
</section>

<!-- FINAL SURPRISE -->

<section class="section hidden" id="finalSection">
 <div class="final-box">
  <div class="big-heart">💗</div>
  <h3>It's my heart.</h3>

  <p>
   All those little hearts you collected were just
   a small part of what I wanted to give you.

   <br><br>

   I wish I could put into words how much I care about
   you. I hope you never forget that you are special
   to me, even on the days when you don't feel like it.

   <br><br>

   I don't need a perfect day to be happy with you.
   I just want more little moments, more laughs,
   more talks and more memories with you.

   <br><br>

   If I could choose someone to make more memories with,
   I'd choose you again.
  </p>

  <div class="final-signature">I love you, Esme ♡</div>

  <div style="margin-top:28px">
   <button class="btn" onclick="celebrate()">
    Send you a million hearts 💕
   </button>
  </div>
 </div>
</section>

</main>

<footer>
 A little website, made for one special girl.
 <br>ESPECIALLY FOR ESME · WITH LOVE ♡
</footer>

</div>

<!-- SECRET HEART BUTTON -->

<button class="secret-heart" onclick="openSecret()" aria-label="Open secret message">
 ♡
</button>

<!-- SECRET MESSAGE WINDOW -->

<div class="secret-modal" id="secretModal" onclick="outsideClose(event)">
 <div class="secret-card">
  <button class="close-secret" onclick="closeSecret()">×</button>
  <div class="secret-icon">💌</div>
  <h2>A secret for you</h2>
  <p>
   Psst... Esme.

   <br><br>

   If you found this, then you found my little secret.

   <br><br>

   I just wanted to remind you that even when I'm not
   saying it, you're still someone I think about.
   I hope you know how much I love having you in my life.

   <br><br>

   And if I had to make this website a thousand times,
   I'd still make every single one for you.

   <br><br>

   You're my favourite little person. ♡
  </p>
  <div class="signature" style="text-align:center">
   Just for you, Esme.
  </div>
 </div>
</div>

<script>

// FLOATING PARTICLES

const particles = document.getElementById("particles");

function createParticle(){
 const p=document.createElement("span");
 p.className="particle";
 p.textContent=["♡","♥","✧","💕","💗"][Math.floor(Math.random()*5)];
 p.style.left=Math.random()*100+"vw";
 p.style.fontSize=(12+Math.random()*23)+"px";
 p.style.animationDuration=(8+Math.random()*9)+"s";
 particles.appendChild(p);
 setTimeout(()=>p.remove(),18000);
}

setInterval(createParticle,450);


// OPEN MAIN PAGE

function openPage(){
 const content=document.getElementById("content");
 content.classList.remove("hidden");
 content.style.animation="appear 1s ease";

 setTimeout(()=>{
  content.scrollIntoView({behavior:"smooth",block:"start"});
 },100);
}


// FIXED LETTER

let letterOpened=false;

function openLetter(){
 if(letterOpened)return;

 letterOpened=true;

 const envelope=document.getElementById("envelope");
 const letter=document.getElementById("letter");
 const hint=document.getElementById("openHint");

 envelope.classList.add("open");
 hint.textContent="♡ YOUR LETTER IS HERE ♡";

 // Reveal the letter separately after the envelope opens.
 setTimeout(()=>{
  letter.classList.add("show");

  setTimeout(()=>{
   letter.scrollIntoView({
    behavior:"smooth",
    block:"center"
   });
  },250);

 },650);
}


// SECRET MESSAGE

function openSecret(){
 document.getElementById("secretModal").classList.add("open");
 document.body.style.overflow="hidden";
}

function closeSecret(){
 document.getElementById("secretModal").classList.remove("open");
 document.body.style.overflow="";
}

function outsideClose(event){
 if(event.target.id==="secretModal"){
  closeSecret();
 }
}

document.addEventListener("keydown",event=>{
 if(event.key==="Escape")closeSecret();
});


// HEART GAME

let score=0;
let playing=false;

const messages=[
 "You make ordinary days feel special. ♡",
 "I love hearing about your day. 💗",
 "You deserve all the happiness in the world. 🌸",
 "Your smile is one of my favourite things. 🎀",
 "I'm so glad I got to meet you. 💌",
 "You will always have a special place in my heart. 🦋",
 "This last heart is yours. Always. 💕"
];

const playArea=document.getElementById("playArea");

function startGame(){
 score=0;
 playing=true;

 document.getElementById("counter").textContent="0 / 7";
 document.getElementById("progress").style.width="0%";
 document.getElementById("startScreen").classList.add("hidden");
 document.getElementById("finishScreen").classList.add("hidden");
 document.getElementById("toast").style.display="none";

 nextHeart();
}

function nextHeart(){
 if(!playing)return;

 const old=playArea.querySelector(".game-heart");
 if(old)old.remove();

 const heart=document.createElement("button");
 heart.className="game-heart";
 heart.textContent=["💗","💖","💕","💘"][Math.floor(Math.random()*4)];
 heart.setAttribute("aria-label","Collect heart");

 const maxX=Math.max(0,playArea.clientWidth-55);
 const maxY=Math.max(0,playArea.clientHeight-55);

 heart.style.left=(Math.random()*maxX)+"px";
 heart.style.top=(Math.random()*maxY)+"px";

 heart.onclick=()=>{
  if(!playing)return;

  score++;

  document.getElementById("counter").textContent=score+" / 7";
  document.getElementById("progress").style.width=(score/7*100)+"%";

  heart.remove();

  const toast=document.getElementById("toast");
  toast.style.display="block";
  toast.textContent=messages[score-1];

  if(score>=7){
   playing=false;

   setTimeout(()=>{
    document.getElementById("finishScreen").classList.remove("hidden");
    toast.style.display="none";
   },450);

   return;
  }

  setTimeout(nextHeart,350);
 };

 playArea.appendChild(heart);
}


// FINAL SURPRISE

function showFinal(){
 const final=document.getElementById("finalSection");
 final.classList.remove("hidden");
 final.style.animation="appear .8s ease";

 setTimeout(()=>{
  final.scrollIntoView({behavior:"smooth",block:"center"});
 },150);

 celebrate();
}


// HEART CELEBRATION

function celebrate(){
 for(let i=0;i<65;i++){
  const heart=document.createElement("div");

  heart.textContent=["💗","💕","💖","💘","🌸"][Math.floor(Math.random()*5)];
  heart.style.position="fixed";
  heart.style.left=Math.random()*100+"vw";
  heart.style.top=Math.random()*100+"vh";
  heart.style.fontSize=(18+Math.random()*25)+"px";
  heart.style.pointerEvents="none";
  heart.style.zIndex="200";
  heart.style.transition="transform 2s ease,opacity 2s ease";

  document.body.appendChild(heart);

  setTimeout(()=>{
   heart.style.transform="translateY(-180px) rotate(360deg) scale(1.5)";
   heart.style.opacity="0";
  },50);

  setTimeout(()=>heart.remove(),2100);
 }
}

</script>

